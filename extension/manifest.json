{
  "manifest_version": 3,
  "name": "Astro.Expert Chart Parser",
  "description": "Parse Astro.Expert chart pages, copy chart data, and work with Vimshottari or Ashtottari dasha trees.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Astro D1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://*.astro.expert/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.astro.expert/*"
      ],
      "js": ["vimshottari.js", "parser-core.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
